# Python
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Source databases and genomes are downloaded, never committed
*.fasta
*.fasta.gz
*.fa
*.fa.gz

# Working outputs; the reports worth keeping are copied into results/
pr2_out/
wbps_out/
wbps_vs_pr2/
pcr_results.json
wbps_genomes.txt

# Downloaded source databases (sources/README.md says where from)
sources/*
!sources/README.md

# Build intermediates
work/

# Releases: the data travel as the tarball; only the manifest and summary
# of each release are committed.
releases/*.tar.gz
releases/*/*
!releases/*/manifest.json
!releases/*/summary.txt
